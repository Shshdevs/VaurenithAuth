AUTH_HOSTNAME=auth.vaurenith.test
ADMIN_AUTH_HOSTNAME=admin.auth.vaurenith.test

AUTH_HTTPS_PORT=8443
ADMIN_HTTPS_PORT=8444
MAILPIT_UI_PORT=8025

POSTGRES_DB=vaurenith_auth
POSTGRES_USER=vaurenith_auth
KEYCLOAK_IMAGE=local/vaurenith-keycloak:26.8.2
POSTGRES_IMAGE=postgres:17.7-alpine
CADDY_IMAGE=caddy:2.10.2-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27.8

KEYCLOAK_MEMORY_LIMIT=2G
POSTGRES_MEMORY_LIMIT=1G
