{
  "realm": "vaurenith",
  "enabled": true,
  "displayName": "Vaurenith",
  "loginTheme": "vaurenith",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ru"],
  "defaultLocale": "ru",
  "defaultSignatureAlgorithm": "RS256",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and passwordHistory(5)",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeoutRememberMe": 1800,
  "ssoSessionMaxLifespanRememberMe": 28800,
  "clientSessionIdleTimeout": 900,
  "clientSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "VaurenithWeb",
      "name": "VaurenithWeb local callback test client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:5173/auth/callback"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.header.type.rfc9068": "true",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "defaultClientScopes": ["basic", "profile", "email", "vaurenith-backend"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "backend-client-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "client_id",
            "claim.value": "VaurenithWeb",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "VaurenithDesktop",
      "name": "VaurenithDesktop fixed loopback callback test client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1:49152/oauth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.header.type.rfc9068": "true",
        "post.logout.redirect.uris": "http://127.0.0.1:49152/logout/callback"
      },
      "defaultClientScopes": ["basic", "profile", "email", "vaurenith-backend"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "backend-client-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "client_id",
            "claim.value": "VaurenithDesktop",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "vaurenith-backend",
      "description": "Access token claims required by VaurenithBackend",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "vaurenith-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "backend-auth-provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "auth_provider",
            "claim.value": "local",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "backend-display-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "display_name",
            "claim.name": "display_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "profile", "email"],
  "defaultOptionalClientScopes": [],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@vaurenith.test",
    "fromDisplayName": "Vaurenith Local",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "users": [],
  "identityProviders": []
}
